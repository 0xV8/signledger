{
  "spec": "SLCS/1",
  "description": "Frozen conformance vectors for SignLedger Canonical Serialization version 1. An implementation in any language is conformant when it turns each decoded input into exactly the bytes given by canonical_hex.",
  "rules": [
    "UTF-8 output, separators ',' and ':', no insignificant whitespace.",
    "Object keys sorted by UTF-16 code unit (RFC 8785 3.2.3), not by code point.",
    "datetime encodes as integer microseconds since the Unix epoch in UTC; naive datetimes are rejected.",
    "NaN, Infinity and -Infinity are rejected.",
    "Only JSON-native types; object keys must be strings.",
    "Integers outside +/-2**53 are rejected.",
    "Numbers follow ECMAScript Number::toString, so 1 and 1.0 both encode as 1.",
    "Maximum encoded size 1048576 bytes; maximum nesting depth 64 containers."
  ],
  "dialect": {
    "$str": "a literal string; the escape hatch for text that would look like a tag",
    "$int": "an integer parsed from a decimal string literal",
    "$float": "an IEEE-754 binary64 parsed from a decimal string literal",
    "$decimal": "an arbitrary-precision decimal (a non-JSON type; expected to be rejected)",
    "$bytes": "the UTF-8 bytes of the given string (a non-JSON type)",
    "$datetime": "an ISO-8601 timestamp; without an offset it denotes a naive datetime",
    "$codepoint": "the single character with the given Unicode code point",
    "$tuple": "an ordered immutable sequence distinct from an array (a non-JSON type)",
    "$set": "an unordered collection (a non-JSON type)",
    "$date": "a calendar date with no time (a non-JSON type)",
    "$object": "an object built from explicit [key, value] pairs, so keys may be non-strings",
    "$repeat": "{value, count}: the value repeated count times, to keep this file small",
    "$nest": "{kind, key, depth}: containers nested depth levels deep",
    "$nonfinite": "one of nan, infinity, -infinity: an IEEE-754 value JSON cannot express"
  },
